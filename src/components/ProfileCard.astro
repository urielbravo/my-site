---
import { Image } from "astro:assets";
import profilePicture from "../assets/images/profile-picture.jpg";
import { site, socialLinks } from "../data/site.js";
import Icon from "./Icon.astro";
import "./ProfileCard.css";
---

<div class="widget profile-card">
    <Image
        class="profile-photo"
        src={profilePicture}
        alt={site.profileAlt}
        width={240}
        densities={[1, 2]}
    />

    <nav class="profile-links" aria-label="Elsewhere on the web">
        {
            socialLinks.map((link) => (
                <a
                    class="profile-link"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    title={link.label}
                >
                    <Icon name={link.icon as "github" | "linkedin" | "resume"} />
                </a>
            ))
        }
    </nav>

    <p class="profile-bio">{site.bio}</p>
</div>