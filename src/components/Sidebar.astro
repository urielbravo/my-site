---
import { widgetTrackLabel } from "../scripts/player.js";
import "./Sidebar.css";

interface Link {
    title: string;
    href: string;
}

interface Props {
    recentPosts: Link[];
    blogroll: Link[];
}

const { recentPosts, blogroll } = Astro.props;

const dayNames = ["S", "M", "T", "W", "T", "F", "S"];
const days = Array.from({ length: 31 }, (_, index) => index + 1);
/** The demo "today": March 25, 2015. */
const today = 25;
/** Keeps the last row of the grid filled, like a real month view. */
const trailingBlanks = 3;
---

<aside class="sidebar">
    <div class="widget">
        <h3>★ Recent Posts ★</h3>
        <ul>
            {
                recentPosts.map((post) => (
                    <li>
                        <a href={post.href}>{post.title}</a>
                    </li>
                ))
            }
        </ul>
    </div>

    <div class="widget">
        <h3>📅 Calendar</h3>
        <div class="calendar-grid">
            {dayNames.map((name) => <span class="day-name">{name}</span>)}
            {
                days.map((day) => (
                    <span class:list={{ today: day === today }}>{day}</span>
                ))
            }
            {Array.from({ length: trailingBlanks }).map(() => <span></span>)}
        </div>
    </div>

    <div class="widget">
        <h3>🔊 Background Music</h3>
        <p class="widget-music-text">
            ♫ Now playing: <em data-track-label>{widgetTrackLabel()}</em>
        </p>
        <div class="widget-controls">
            <button type="button" data-action="play">▶</button>
            <button type="button" data-action="pause">⏸</button>
            <button type="button" data-action="stop">⏹</button>
        </div>
    </div>

    <div class="widget">
        <h3>🔗 Blogroll</h3>
        <ul>
            {
                blogroll.map((link) => (
                    <li>
                        <a href={link.href}>{link.title}</a>
                    </li>
                ))
            }
        </ul>
    </div>
</aside>

<script>
    import "./Sidebar.js";
</script>