---
import ProfileCard from "./ProfileCard.astro";
import "./Sidebar.css";
import { WEEKDAY_INITIALS, buildMonthCells, monthLabel } from "../utils/calendar.js";

interface Link {
    title: string;
    href: string;
}

interface Category {
    name: string;
    href: string;
}

interface Props {
    recentPosts: Link[];
    categories: Category[];
    /** Category currently being viewed, so it can be marked as such. */
    activeCategory?: string;
}

const { recentPosts, categories, activeCategory } = Astro.props;

/** Rendered at build time; Sidebar.js re-renders if the build has gone stale. */
const buildDate = new Date();
const calendarCells = buildMonthCells(buildDate);
const calendarLabel = monthLabel(buildDate);
---

<aside class="sidebar">
    <ProfileCard />

    <div class="widget">
        <h3>★ Recent Posts ★</h3>
        <ul>
            {
                recentPosts.map((post) => (
                    <li>
                        <a href={post.href}>{post.title}</a>
                    </li>
                ))
            }
        </ul>
    </div>

    <div class="widget" data-calendar>
        <h3>📅 Calendar</h3>

        <div class="calendar-head">
            <button
                type="button"
                class="calendar-nav"
                data-calendar-prev
                aria-label="Previous month"
            >
                ◀
            </button>
            <button
                type="button"
                class="calendar-month"
                data-calendar-label
                title="Back to the current month"
            >
                {calendarLabel}
            </button>
            <button
                type="button"
                class="calendar-nav"
                data-calendar-next
                aria-label="Next month"
            >
                ▶
            </button>
        </div>

        <div class="calendar-grid" data-calendar-grid>
            {
                WEEKDAY_INITIALS.map((initial) => (
                    <span class="day-name">{initial}</span>
                ))
            }
            {
                calendarCells.map((day) =>
                    day === null ? (
                        <span class="is-blank"></span>
                    ) : (
                        <span
                            class:list={["day", { "is-today": day === buildDate.getDate() }]}
                            data-day={day}
                        >
                            {day}
                        </span>
                    ),
                )
            }
        </div>
    </div>

    <div class="widget">
        <h3>🏷 Categories</h3>
        <ul class="category-grid">
            {
                categories.map((category) => (
                    <li>
                        <a
                            class="category-chip"
                            href={category.href}
                            aria-current={
                                category.name === activeCategory
                                    ? "page"
                                    : undefined
                            }
                        >
                            {category.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</aside>

<script>
    import "./Sidebar.js";
</script>