---
import ProfileCard from "./ProfileCard.astro";
import "./Sidebar.css";

interface Link {
    title: string;
    href: string;
}

interface Category {
    name: string;
    href: string;
}

interface Props {
    recentPosts: Link[];
    categories: Category[];
    /** Category currently being viewed, so it can be marked as such. */
    activeCategory?: string;
}

const { recentPosts, categories, activeCategory } = Astro.props;

const dayNames = ["S", "M", "T", "W", "T", "F", "S"];
const days = Array.from({ length: 31 }, (_, index) => index + 1);
/** The demo "today": March 25, 2015. */
const today = 25;
/** Keeps the last row of the grid filled, like a real month view. */
const trailingBlanks = 3;
---

<aside class="sidebar">
    <ProfileCard />

    <div class="widget">
        <h3>★ Recent Posts ★</h3>
        <ul>
            {
                recentPosts.map((post) => (
                    <li>
                        <a href={post.href}>{post.title}</a>
                    </li>
                ))
            }
        </ul>
    </div>

    <div class="widget">
        <h3>📅 Calendar</h3>
        <div class="calendar-grid">
            {dayNames.map((name) => <span class="day-name">{name}</span>)}
            {
                days.map((day) => (
                    <span class:list={{ today: day === today }}>{day}</span>
                ))
            }
            {Array.from({ length: trailingBlanks }).map(() => <span></span>)}
        </div>
    </div>

    <div class="widget">
        <h3>🏷 Categories</h3>
        <ul class="category-grid">
            {
                categories.map((category) => (
                    <li>
                        <a
                            class="category-chip"
                            href={category.href}
                            aria-current={
                                category.name === activeCategory
                                    ? "page"
                                    : undefined
                            }
                        >
                            {category.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</aside>

<script>
    import "./Sidebar.js";
</script>