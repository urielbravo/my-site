---
import { formatDate } from "../utils/date.js";
import "./PostCard.css";

interface Props {
    title: string;
    date: Date;
    description: string;
    href: string;
    featured?: boolean;
}

const { title, date, description, href, featured = false } = Astro.props;
---

<article class:list={["post-card", { "featured-post": featured }]}>
    <h2 class="post-title">{title}</h2>
    <div class="post-meta">Posted on {formatDate(date)}</div>
    <div class="post-content">
        <p>{description}</p>
    </div>
    <a href={href} class="read-more">Read More →</a>
</article>