---
import "./PostCard.css";

interface Props {
    title: string;
    date: string;
    paragraphs: string[];
    featured?: boolean;
    lead?: string;
}

const { title, date, paragraphs, featured = false, lead } = Astro.props;

// A lead-in, when present, is bolded and glued to the front of the first paragraph.
const body = lead ? paragraphs.slice(1) : paragraphs;
---

<article class:list={["post-card", { "featured-post": featured }]}>
    <h2 class="post-title">{title}</h2>
    <div class="post-meta">Posted on {date}</div>
    <div class="post-content">
        {lead && <p><strong>{lead}</strong>{" "}{paragraphs[0]}</p>}
        {body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <a href="#" class="read-more">Read More →</a>
</article>

<script>
    import "./PostCard.js";
</script>