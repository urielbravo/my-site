---
import Marquee from "../../components/Marquee.astro";
import PostCard from "../../components/PostCard.astro";
import RetroFooter from "../../components/RetroFooter.astro";
import RetroHeader from "../../components/RetroHeader.astro";
import Sidebar from "../../components/Sidebar.astro";
import SiteNav from "../../components/SiteNav.astro";
import { site } from "../../data/site.js";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
    getSortedPosts,
    postHref,
    postsInCategory,
    slugify,
    toCategories,
    toRecentPosts,
} from "../../utils/posts.js";

export async function getStaticPaths() {
    const posts = await getSortedPosts();
    const categories = new Set(posts.map((post) => post.data.category));

    return [...categories].map((category) => ({
        params: { category: slugify(category) },
        props: { category, posts: postsInCategory(posts, category) },
    }));
}

const { category, posts } = Astro.props;

const allPosts = await getSortedPosts();
const categories = toCategories(allPosts);
const recentPosts = toRecentPosts(allPosts);
---

<BaseLayout title={`${category} · ${site.name}`}>
    <div class="retro-wrapper">
        <RetroHeader />

        <SiteNav />
        <Marquee message={site.marquee} />

        <div class="content-grid">
            <div class="posts">
                <h2 class="category-heading">
                    🏷 <span>{category}</span>
                    <small>
                        {posts.length}
                        {posts.length === 1 ? "post" : "posts"}
                    </small>
                </h2>

                {
                    posts.map((post) => (
                        <PostCard
                            title={post.data.title}
                            date={post.data.date}
                            description={post.data.description}
                            href={postHref(post)}
                            featured={post.data.featured}
                        />
                    ))
                }
            </div>

            <Sidebar
                recentPosts={recentPosts}
                categories={categories}
                activeCategory={category}
            />
        </div>

        <RetroFooter />
    </div>
</BaseLayout>