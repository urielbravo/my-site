---
import RetroFooter from "../components/RetroFooter.astro";
import RetroHeader from "../components/RetroHeader.astro";
import Marquee from "../components/Marquee.astro";
import PostCard from "../components/PostCard.astro";
import Sidebar from "../components/Sidebar.astro";
import SiteNav from "../components/SiteNav.astro";
import { blogroll, posts, recentPosts, site } from "../data/site.js";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/layout.css";
---

<BaseLayout title={site.title}>
    <div class="retro-wrapper">
        <RetroHeader />

        <SiteNav />
        <Marquee message={site.marquee} />

        <div class="content-grid">
            <div class="posts">
                {posts.map((post) => <PostCard {...post} />)}
            </div>

            <Sidebar recentPosts={recentPosts} blogroll={blogroll} />
        </div>

        <RetroFooter />
    </div>
</BaseLayout>

<script>
    import "../scripts/console.js";
</script>