---
import PostList from "../components/PostList.astro";
import { site } from "../data/site.js";
import BlogLayout from "../layouts/BlogLayout.astro";
import { splitIntoPages } from "../utils/pagination.js";
import {
    getSortedPosts,
    toCategories,
    toRecentPosts,
} from "../utils/posts.js";

const posts = await getSortedPosts();
const pages = splitIntoPages(posts);
const recentPosts = toRecentPosts(posts);
const categories = toCategories(posts);
---

<BlogLayout
    title={site.title}
    recentPosts={recentPosts}
    categories={categories}
>
    <PostList posts={pages[0]} currentPage={1} lastPage={pages.length} />
</BlogLayout>

<script>
    import "../scripts/console.js";
</script>