---
import { render } from "astro:content";
import Marquee from "../../components/Marquee.astro";
import Post from "../../components/Post.astro";
import RetroFooter from "../../components/RetroFooter.astro";
import RetroHeader from "../../components/RetroHeader.astro";
import Sidebar from "../../components/Sidebar.astro";
import SiteNav from "../../components/SiteNav.astro";
import { site } from "../../data/site.js";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
    getSortedPosts,
    toCategories,
    toRecentPosts,
} from "../../utils/posts.js";

export async function getStaticPaths() {
    const posts = await getSortedPosts();
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;

const { Content } = await render(post);
const allPosts = await getSortedPosts();
const recentPosts = toRecentPosts(allPosts);
const categories = toCategories(allPosts);
---

<BaseLayout title={`${post.data.title} · ${site.name}`}>
    <div class="retro-wrapper">
        <RetroHeader />

        <SiteNav />
        <Marquee message={site.marquee} />

        <div class="content-grid">
            <div class="posts">
                <Post title={post.data.title} date={post.data.date}>
                    <Content />
                </Post>
            </div>

            <Sidebar recentPosts={recentPosts} categories={categories} />
        </div>

        <RetroFooter />
    </div>
</BaseLayout>