---
import Marquee from "../components/Marquee.astro";
import RetroFooter from "../components/RetroFooter.astro";
import RetroHeader from "../components/RetroHeader.astro";
import Sidebar from "../components/Sidebar.astro";
import SiteNav from "../components/SiteNav.astro";
import { site } from "../data/site.js";
import BaseLayout from "./BaseLayout.astro";

interface Link {
    title: string;
    href: string;
}

interface Category {
    name: string;
    href: string;
}

interface Props {
    title: string;
    recentPosts: Link[];
    categories: Category[];
    /** Category being viewed, highlighted in the sidebar. */
    activeCategory?: string;
}

const { title, recentPosts, categories, activeCategory } = Astro.props;
---

<BaseLayout title={title}>
    <div class="retro-wrapper">
        <RetroHeader />

        <SiteNav />
        <Marquee />

        <div class="content-grid">
            <div class="posts">
                <slot />
            </div>

            <Sidebar
                recentPosts={recentPosts}
                categories={categories}
                activeCategory={activeCategory}
            />
        </div>

        <RetroFooter />
    </div>
</BaseLayout>